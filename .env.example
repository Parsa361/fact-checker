BOT_TOKEN=123456:ABCDEF
WEBHOOK_SECRET=change-me
PUBLIC_BASE_URL=https://bot.example.com
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL_TRIAGE=gemini-3.5-flash-lite
GEMINI_MODEL_VERDICT=gemini-3.5-flash
# مدل مرحله جستجو جداست چون grounding روی مدل‌های ۳.۵ در پلن رایگان سهمیه ندارد
GEMINI_MODEL_GROUNDING=gemini-2.5-flash
GOOGLE_GROUNDING_ENABLED=true
TAVILY_API_KEY=optional-fallback-key
# ⚠️ روی true بگذارید اگر کلید دارید: سهمیه رایگان grounding مرتب به سقف می‌خورد
# و بدون این fallback کاربر حکم «نیازمند بررسی / اعتماد ۰٪» می‌گیرد.
TAVILY_ENABLED=true
# بعد از خوردن grounding به سقف سهمیه، این مدت مستقیم سراغ Tavily می‌رویم
GROUNDING_QUOTA_COOLDOWN_MINUTES=5
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://...
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Tehran
DAILY_FREE_CHECK_LIMIT=5
# سطل جدا برای پیام‌های گروهی؛ از سهمیه شخصی کاربر کم نمی‌کند (Task 13)
GROUP_DAILY_CHECK_LIMIT=20
CACHE_TTL_DAYS=14
# خروجی ۳۰۷۲بعدی است و در کد به ۷۶۸ (اندازه ستون دیتابیس) کوتاه و نرمال می‌شود
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# فاصله کسینوسی: ۰ = یک معنا، بزرگ‌تر = نامرتبط‌تر. بالا بردنش ریسک جواب اشتباه دارد
CACHE_SIMILARITY_THRESHOLD=0.12
MAX_INPUT_CHARS=2000
MAX_CONCURRENT_JOBS=4
# مقدار ۰ یعنی توقف کامل مصرف API بدون نیاز به deploy
GLOBAL_DAILY_API_BUDGET=2000
FLOOD_WINDOW_SECONDS=30
JOB_MAX_ATTEMPTS=2
JOB_TIMEOUT_MS=120000
# باید از JOB_TIMEOUT_MS بزرگ‌تر باشد وگرنه کارهای در حال اجرا گیرکرده حساب می‌شوند
JOB_STUCK_AFTER_MINUTES=10
JOB_MAX_RECOVERY_AGE_MINUTES=30
SHUTDOWN_DRAIN_MS=60000
TRUST_PROXY=true
# شناسه‌ی عددی تلگرام‌ات را از @userinfobot بگیر. خالی = دستور /stats خاموش است
ADMIN_TELEGRAM_IDS=
CHECKS_REDACT_AFTER_DAYS=180
RATE_LIMIT_EVENTS_RETENTION_DAYS=90
